#!/usr/bin/env python3
"""Fake `claude` for plumbing tests: never calls a model. Echoes what it was given inside a verdict-shaped result."""
import json, os, sys
if "--version" in sys.argv:
    print("2.1.287 (Claude Code)"); sys.exit(0)
prompt = sys.stdin.read()
creds = open(os.environ["AWS_SHARED_CREDENTIALS_FILE"]).read() if os.environ.get("AWS_SHARED_CREDENTIALS_FILE") else ""
sys.stderr.write("creds-seen:\n" + creds + "\nleaked jwt eyJhbGciOiJIUzI1NiJ9.eyJzdWIiOiJmYWtlIn0.c2lnbmF0dXJlZmFrZQ\n")
settings = json.load(open(sys.argv[sys.argv.index("--settings") + 1]))
verdict = {"decision": "HOLD", "obligations": [{"id": "CHG-2", "status": "open", "note": "fake"}], "summary": "fake"}
gitcfg = open(os.path.join(os.getcwd(), ".git", "config")).read()
debug = {"argv": sys.argv[1:], "env_keys": sorted(os.environ), "cwd": os.getcwd(), "prompt_head": prompt[:120],
         "home": os.environ.get("HOME"), "sandbox": settings.get("sandbox"), "gitcfg": gitcfg,
         "hooks": os.path.exists(os.path.join(os.getcwd(), ".git", "hooks")),
         "creds_mode": oct(os.stat(os.environ["AWS_SHARED_CREDENTIALS_FILE"]).st_mode & 0o777)}
result = {"type": "result", "subtype": "success", "is_error": False, "num_turns": 3, "session_id": "fake",
          "result": "Done.\n```json\n" + json.dumps(verdict) + "\n```", "total_cost_usd": 0.5,
          "modelUsage": {"us.anthropic.claude-opus-5-5": {"inputTokens": 1000, "outputTokens": 2000,
                         "cacheReadInputTokens": 100000, "cacheCreationInputTokens": 20000}}, "debug": debug}
print(json.dumps({"type": "system", "subtype": "init", "model": "us.anthropic.claude-opus-5-5", "apiKeySource": "none",
                  "permissionMode": "default", "tools": ["Read", "Grep", "Glob", "Bash"]}))
print(json.dumps(result))
